 /* Includes ------------------------------------------------------------------*/
+#include <stdio.h>              /* HardFault_Handler 要 printf 现场 */
 #include "stm32l1xx_it.h"
 #include "main.h"
 
@@ -56,14 +57,53 @@ void NMI_Handler(void)
